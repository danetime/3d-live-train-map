{
  "name": "3d-live-train-map-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Network Rail Train Describer (TD) feed → WebSocket bridge for the 3D train map.",
  "scripts": {
    "start": "node index.js",
    "live": "node --env-file=.env index.js",
    "capture": "CAPTURE=1 node --env-file=.env index.js",
    "build:coords": "node --env-file=.env scripts/buildBerthCoords.js",
    "build:coords:sample": "node scripts/buildBerthCoords.js --sample",
    "berths:mainline": "node --env-file=.env scripts/extractMainLineBerths.js",
    "berths:mainline:sample": "node scripts/extractMainLineBerths.js --sample --direction up --chain CDF,EXD",
    "berths:all": "node --env-file=.env scripts/buildAllBerths.js",
    "berths:all:sample": "node scripts/buildAllBerths.js --sample",
    "schedule": "node --env-file=.env scripts/buildSchedule.js",
    "schedule:sample": "node scripts/buildSchedule.js --sample"
  },
  "dependencies": {
    "stompit": "^1.0.0",
    "ws": "^8.18.0"
  }
}
