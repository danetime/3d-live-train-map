# Network Rail Open Data feed credentials — for the live TD (Train Describer) feed.
# Register (free) at https://publicdatafeeds.networkrail.co.uk/ (the NROD portal),
# then enable the "TD" feed for your account. Copy this file to ".env" and fill in.
# NOTE: put your real credentials in ".env" (which is gitignored) — NOT here.
# Without these, the server runs in REPLAY mode (synthetic demo trains).
NR_USERNAME=
NR_PASSWORD=

# TD topic. Use TD_ALL_SIG_AREA — the per-region topics are unmaintained
# (TD_SW is Scotland West, NOT South West England!).
TD_TOPIC=TD_ALL_SIG_AREA

# Devon signalling areas to keep from the all-UK feed:
# EX = Exeter PSB (main line + Paignton), ZY = Exmouth branch, PH = Plymouth.
# Also used by build:coords to filter the coordinate output.
TD_AREAS=EX,ZY,PH

# Port the browser app connects to over WebSocket.
WS_PORT=4001
