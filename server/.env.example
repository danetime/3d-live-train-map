# Network Rail Open Data feed credentials — for the live TD (Train Describer) feed.
# Register (free) at https://publicdatafeeds.networkrail.co.uk/ (the NROD portal),
# then enable the "TD" feed for your account. Copy this file to ".env" and fill in.
# NOTE: put your real credentials in ".env" (which is gitignored) — NOT here.
# Without these, the server runs in REPLAY mode (synthetic demo trains).
NR_USERNAME=
NR_PASSWORD=

# TD topic. Use TD_ALL_SIG_AREA — the per-region topics are unmaintained
# (TD_SW is Scotland West, NOT South West England!).
TD_TOPIC=TD_ALL_SIG_AREA

# Devon signalling areas to keep from the all-UK feed:
# EX = Exeter PSB (main line + Paignton), ZY = Exmouth branch, PH = Plymouth.
# Also used by build:coords to filter the coordinate output.
TD_AREAS=EX,ZY,PH

# Port the browser app connects to over WebSocket.
WS_PORT=4001

# ---- Darwin formations (OPTIONAL — real coach counts + live loading) ----
# Subscribe (free) to "Darwin Real Time Train Information (PubSub)" on the
# Rail Data Marketplace at https://raildata.org.uk, then copy the values from
# the subscription's connection details page. RDM serves Darwin over Kafka
# (SASL_SSL / PLAIN; username+password are the Consumer key/secret) with JSON
# messages — there is no STOMP option on the marketplace.
# Leave blank to run without formations (everything else works as before).
DARWIN_BROKERS=            # Kafka bootstrap server(s), comma-separated host:port
DARWIN_USERNAME=           # Consumer key
DARWIN_PASSWORD=           # Consumer secret
DARWIN_TOPIC=              # topic name from the product page

# DARWIN_GROUP=exeter-train-map  # Kafka consumer group id
# DARWIN_OFFSET=latest           # "earliest" replays retained history on first
#                                # run (catches overnight formations, but chews
#                                # through the all-UK backlog first)
# DARWIN_SASL=plain              # or scram-sha-256 / scram-sha-512
# DARWIN_DEBUG=1                 # save first raw messages to data/darwinSamples/
