{
  "name": "3d-live-train-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A low-poly, Minecraft-style 3D world that shows trains moving around the Exeter area.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fetch:track": "node scripts/fetchTrackGeometry.mjs",
    "tiles:rail": "node scripts/railTiles.mjs --preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@pixellab-code/pixellab": "^1.0.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
